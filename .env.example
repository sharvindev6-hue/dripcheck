# Copy to .env.local and fill in your values.
# The Supabase pair is required for auth, data and storage.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only keys. Without them the app runs in rules mode:
# no LLM stylist voice, no image tagging/scan, no live weather.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
GEMINI_API_KEY=
OPENWEATHER_API_KEY=

# Optional server-only: demo seeder + cleanup of legacy storage objects.
# Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_USER_EMAIL=
DEMO_SEED=
