# Copy to .env.local and fill in your values.
# The Supabase pair is required for auth, data and storage.

# Local: npx supabase start, then copy the API URL and publishable key
# from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only keys. Without them the app runs in rules mode:
# no LLM stylist voice, no image tagging/scan, no live weather.
# NVIDIA NIM is preferred when set; Gemini is the vision fallback.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_NIM_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
GEMINI_API_KEY=
OPENWEATHER_API_KEY=

# Optional server-only: demo seeder, dev-only one-click login, and cleanup
# of legacy storage objects. Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_USER_EMAIL=
DEMO_SEED=
