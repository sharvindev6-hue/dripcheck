# Copy to .env.local and fill in your values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional AI features — the app works without these (rules mode).
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
GEMINI_API_KEY=
OPENWEATHER_API_KEY=

# Demo seeder (optional, scripts/seed-demo.ts).
# Set DEMO_SEED=true and run `npx tsx scripts/seed-demo.ts`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_USER_EMAIL=
DEMO_SEED=
